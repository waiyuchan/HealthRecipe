# Optional generic OpenAI-compatible chat endpoint. No keys belong in Git or the browser.
# Copy to .env, fill locally, then run:
# uv run --env-file .env uvicorn src.app:app --host 127.0.0.1 --port 8000
HEALTHRECIPE_LLM_PROVIDER=custom
HEALTHRECIPE_LLM_BASE_URL=
HEALTHRECIPE_LLM_MODEL=
HEALTHRECIPE_LLM_API_KEY=
# Explicit provider shortcuts (optional, never auto-enabled by ambient credentials):
# HEALTHRECIPE_LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HEALTHRECIPE_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
